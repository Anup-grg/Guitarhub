# Copy to apps/api/.env for local development (already set up for the dev database).

# Local development database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:GuitarHub_dev_2026@localhost:5432/guitarhub?schema=public"

PORT=4000
LOG_LEVEL=info

# Public origin of the web app. Local dev default; set to the real https URL in production.
APP_URL=http://localhost:3000
# Set to true behind TLS so auth cookies get the `__Host-` prefix + Secure flag.
COOKIE_SECURE=false
# Honor X-Forwarded-* headers when running behind the Caddy reverse proxy.
TRUST_PROXY=true

# ---- docker-compose / production overrides ----
# Used by docker-compose (passwords must be changed before deploying).
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=guitarhub
MINIO_ROOT_PASSWORD=change-me

# Outbound email. Empty SMTP_URL logs mails to the process output (dev outbox).
# Example: smtp://user:pass@smtp.example.com:587
# SMTP_URL=
# MAIL_FROM="GuitarHub <no-reply@guitarhub.example.com>"

# OAuth 2.0 providers (Authorization Code + PKCE). Empty = provider disabled.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Preset files: "local" stores on disk (dev default), "s3" talks to MinIO/AWS.
# STORAGE_DRIVER=local
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=guitarhub-presets
# Secret for HMAC-signing local upload URLs (STORAGE_DRIVER=local).
# 32+ random bytes: openssl rand -hex 32
# STORAGE_SIGNING_SECRET=

# Have I Been Pwned k-anonymity range check for new passwords (default: false).
# HIBP_CHECK=true